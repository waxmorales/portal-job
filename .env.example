# ==============================================================================
# Portal Job — Environment Variables Template (Architecture Blueprint)
# Copy to .env.local for implementation. Never commit real credentials.
# ==============================================================================

# --- Supabase (PostgreSQL + Auth + RLS) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only privileged key (used strictly in server-side Route Handlers for
# deterministic evaluation ledger mutations & partner verification; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- AI Mentor Layer (Server-side only — separated from deterministic scoring) ---
AI_PROVIDER_API_KEY="your-llm-api-key"
AI_FEEDBACK_MODEL="claude-sonnet-or-compatible"
AI_DAILY_QUOTA_PER_USER="20"

# --- Application & Telemetry ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SIMULATION_ENGINE_VERSION="1.0.0"
